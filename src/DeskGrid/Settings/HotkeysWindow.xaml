<Window x:Class="DeskGrid.Settings.HotkeysWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <!-- The rows are made in code (they hold HotkeyBox, a type of this assembly, which XAML here can't name). -->
  <DockPanel Margin="20,16,20,20">
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="Error" Margin="2,4,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
      <DockPanel Margin="0,12,0,0">
        <Button DockPanel.Dock="Left" Padding="12,5" x:Name="ResetButton" Click="OnReset" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button MinWidth="84" Padding="12,5" x:Name="OkButton" IsDefault="True" Click="OnOk" />
          <Button MinWidth="84" Padding="12,5" x:Name="CancelButton" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" x:Name="Intro" Margin="2,0,0,12" Opacity="0.75" TextWrapping="Wrap" />

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Groups" Margin="0,0,4,0" />
    </ScrollViewer>
  </DockPanel>
</Window>
