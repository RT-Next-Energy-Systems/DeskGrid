<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Window.ThemeMode (Fluent theme) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeskGrid</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\DeskGrid.ico</ApplicationIcon>
    <!-- Only the languages DeskGrid speaks: without this, WPF's resources in a dozen more languages add 3.4 MB to the exe.
         zh-Hant is where WPF's own Traditional Chinese texts (e.g. a text box's Cut / Copy / Paste) live. -->
    <SatelliteResourceLanguages>en;zh-Hant;zh-TW</SatelliteResourceLanguages>

    <!-- Lightweight in the background: no extra background-GC thread, and no profile-guided instrumentation overhead
         in a program that mostly sits idle. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>

    <!-- Release builds override Version from the git tag (see .github/workflows/release.yml). -->
    <Version>0.8.0</Version>
    <!-- The SDK would append "+<commit>" to the product version, so it differed between builds of one release.
         Code-signing services (SignPath Foundation) require the product name and version to be fixed. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>DeskGrid</Product>
    <Authors>Ryan Kuo</Authors>
    <Copyright>Copyright (c) 2026 Ryan Kuo</Copyright>
    <Description>Phone-style folders on the Windows desktop.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskGrid.Tests" />
  </ItemGroup>

  <!-- Shown by the settings window, so it is always the log of the version that is running. The Strings resource
       ChangeLogResource names the one for the interface language. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="..\..\CHANGELOG.zh-TW.md" LogicalName="CHANGELOG.zh-TW.md" WithCulture="false" />
  </ItemGroup>

  <!-- Strings is generated into obj/ during the build, too late for WPF's temporary markup assembly:
       XAML must not reference types of this assembly, so dialogs set their texts in code-behind. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>DeskGrid.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NotiLand is BrimDeck (third_party/BrimDeck), which runs beside DeskGrid. A development build puts a normal build of it in
       NotiLand\ next to DeskGrid.exe; a release (PublishNotiLand, set by the publish profile) publishes it as one self-contained
       exe and embeds that in DeskGrid.exe, where NotiLandHost unpacks it on first use. -->
  <PropertyGroup>
    <BrimDeckProject>$(MSBuildThisFileDirectory)../../third_party/BrimDeck/src/BrimDeck/BrimDeck.csproj</BrimDeckProject>
    <BrimDeckPublishDir>$(MSBuildThisFileDirectory)obj/notiland-publish/</BrimDeckPublishDir>
    <BrimDeckBuildDir>$(MSBuildThisFileDirectory)obj/notiland-build/</BrimDeckBuildDir>
  </PropertyGroup>

  <Target Name="PublishNotiLand" BeforeTargets="AssignTargetPaths" Condition="'$(PublishNotiLand)' == 'true'">
    <Exec Command="dotnet publish &quot;$(BrimDeckProject)&quot; -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -p:DebugType=none -p:Version=$(Version) -o &quot;$(BrimDeckPublishDir)&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(BrimDeckPublishDir)BrimDeck.exe" LogicalName="DeskGrid.NotiLand.exe" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="BuildNotiLand" AfterTargets="Build" Condition="'$(PublishNotiLand)' != 'true' And '$(BuildNotiLand)' != 'false'">
    <MSBuild Projects="$(BrimDeckProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=x64;OutDir=$(BrimDeckBuildDir);Restore=true" />
    <ItemGroup>
      <NotiLandFiles Include="$(BrimDeckBuildDir)**\*" Exclude="$(BrimDeckBuildDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(NotiLandFiles)" DestinationFiles="@(NotiLandFiles->'$(OutDir)NotiLand\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
