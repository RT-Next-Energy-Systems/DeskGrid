<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained exe: dotnet publish src/DeskGrid/DeskGrid.csproj -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native libraries go inside the exe too; they are extracted to %TEMP% on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not compressed: a compressed bundle is unpacked into private memory when the program starts (every assembly, 198 MB of them), which
         is 68 MB of private memory and 130 MB of working set at the start (measured), and about 130 ms of every start, including the second
         process a taskbar button used to start. Uncompressed they are mapped from the exe and only what runs is read. The exe is bigger
         (about 198 MB instead of 83 MB), which is the only cost; see context/decisions.md (2026-11-23 (6)). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
